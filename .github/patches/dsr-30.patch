+/***********************************************************************
+ *	madeira_force_builtin_dll
+ *
+ * Madeira: XInput is how the touch/paired controllers reach Windows games
+ * (xinput1_x host_pad_state -> win32u host query). Games often ship
+ * Microsoft's redistributable XInput1_3.dll next to the exe; the app
+ * directory is searched first and, since the iOS unix loader never swaps a
+ * native image for the builtin (load_builtin short-circuits), that native
+ * copy wins, probes the nonexistent XUSB driver and reports no controllers.
+ * Upstream Wine would load its builtin here (default load order), so pin
+ * these names to system32. MADEIRA_NATIVE_XINPUT=1 restores the old search.
+ */
+static BOOL madeira_force_builtin_dll( const WCHAR *name )
+{
+    static const WCHAR * const names[] =
+    {
+        L"xinput1_1.dll", L"xinput1_2.dll", L"xinput1_3.dll", L"xinput1_4.dll",
+        L"xinput9_1_0.dll", L"xinputuap.dll",
+    };
+    static int native = -1;
+    unsigned int i;
+
+    if (native < 0)
+    {
+        UNICODE_STRING nm, val;
+        WCHAR buf[8];
+        RtlInitUnicodeString( &nm, L"MADEIRA_NATIVE_XINPUT" );
+        val.Buffer = buf; val.Length = 0; val.MaximumLength = sizeof(buf);
+        native = (!RtlQueryEnvironmentVariable_U( NULL, &nm, &val ) && val.Length && buf[0] == '1');
+    }
+    if (native) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+        if (!wcsicmp( name, names[i] )) return TRUE;
+    return FALSE;
+}
+
 /***********************************************************************
  *	find_dll_file
  *
@@ -3935,6 +3971,11 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
 
     if (RtlDetermineDosPathNameType_U( libname ) == RtlPathTypeRelative)
     {
+        if (madeira_force_builtin_dll( libname ))
+        {
+            TRACE( "madeira: %s pinned to system32 (builtin), app-dir copy ignored\n", debugstr_w(libname) );
+            load_path = system_dir;
+        }
         status = search_dll_file( load_path, libname, nt_name, pwm, mapping, image_info, id );
         if (status == STATUS_DLL_NOT_FOUND)
             status = find_builtin_without_file( libname, nt_name, pwm, mapping, image_info, id );
